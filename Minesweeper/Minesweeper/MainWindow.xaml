<Window x:Class="Minesweeper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Minesweeper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Text="Minesweeper" FontSize="50" FontFamily="Times New Roman" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 50, 0, 0"/>
        <TextBlock Text="Size: 9x9" FontSize="40" FontFamily="Times New Roman" Margin="150, 0, 0, 0" Height="50" Width="200" HorizontalAlignment="Left"/>
        <Menu FontSize="40" FontFamily="Times New Roman" Margin="0, 0, 100, 0" Height="50" Width="250" HorizontalAlignment="Right">
            <MenuItem Header="Silly Theme"/>
            <MenuItem Header="Cool Theme"/>
            <MenuItem Header="Evil Theme"/>
        </Menu>
        <Button x:Name="Start" Content="Start" FontSize="50" Height="60" Width="200" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Center" FontFamily="Times New Roman" VerticalAlignment="Bottom" Margin="0, 0, 0, 100" BorderThickness="3"/>
    </Grid>
</Window>
